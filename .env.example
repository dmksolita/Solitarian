# Required environment variables for local development.
# Copy this file to .env and fill in the values. Never commit .env.

# API key for the canteen menu endpoint (http://api.solitarian.dk/menu).
# In CI/CD this is stored as the repository secret MENU_API_KEY.
# If omitted, the fetch is attempted without authentication (useful for local dev
# against an unauthenticated staging endpoint).
MENU_API_KEY=
