---
layout: layouts/base.njk
---
<section id="content" class="main">
  <header class="major">
    <p class="post-meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {% if author %} &middot; {{ author }}{% endif %}
    </p>
    <h2>{{ title }}</h2>
    {% if description %}<p>{{ description }}</p>{% endif %}
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
</section>
